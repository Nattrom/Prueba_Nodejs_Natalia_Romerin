# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# If using the Docker container on port 5435, set DB_PORT=5435
DB_HOST=localhost
DB_PORT=5435
DB_NAME=riwimedicare_plus
DB_USER=riwi_user
DB_PASSWORD=your_secure_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRATION=24h

# Swagger Configuration
SWAGGER_TITLE=RiwiMediCare Plus API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Backend API for medicine supply management