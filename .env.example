# Server Configuration
PORT=3000
NODE_ENV=development

# PostgreSQL Database Configuration
# Local PostgreSQL example. Docker Compose injects DB_HOST=postgres and DB_PORT=5432.
DB_HOST=localhost
DB_PORT=5435
DB_NAME=riwimedicare_plus
DB_USER=riwi_user
DB_PASSWORD=riwi_password

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# Swagger Configuration
SWAGGER_TITLE=RiwiMediCare Plus API
SWAGGER_VERSION=1.0.0
SWAGGER_DESCRIPTION=Backend API for medicine supply management